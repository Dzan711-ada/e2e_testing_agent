# DeepSeek is primary when configured. Qwen is the optional fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
REQUEST_TIMEOUT=60
ACTION_TIMEOUT_MS=10000
WORKER_TIMEOUT=45
REPLAY_TIMEOUT=120
MAX_ACTIONS=16
# Headless by default. Pass --headed to show the browser.
HEADLESS=true

# G7 public practice profile uses the same configured model services.
# Public demo resources come from the project provider, never from model prompts.
# Exported suites need E2E_RESOURCE_USERNAME / PASSWORD / WRONG_PASSWORD or the parent console.
# Keep MAX_ACTIONS >= 8 for the fixed positive/negative practice-login bundle.
